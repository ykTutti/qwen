DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 阿里云百炼（DashScope）的 API Key；配置后模型列表里的 Qwen 模型会真实调用，未配置时 Qwen 模型返回演示数据
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 工作模式下 agent 的工作区根目录，每个对话在其下 sessions/<sandboxId> 有自己的目录；相对路径基于 qwen-server，默认 workspace
AGENT_WORKSPACE=
# 技能目录，每个技能一个子目录（含 SKILL.md）；相对路径基于 qwen-server，默认 skills
AGENT_SKILLS_DIR=
# 终端命令的沙箱：auto（默认，Docker 可用就用容器，否则直接在宿主机执行）、docker（必须用 Docker）、none（不用容器）
AGENT_SANDBOX=auto
# 沙箱镜像，首次部署先执行：docker build -t qwen-sandbox qwen-server/sandbox
AGENT_SANDBOX_IMAGE=qwen-sandbox
# 沙箱容器网络：none（默认断网）；需要 npm install / pip install 时设为 bridge
AGENT_SANDBOX_NETWORK=none
